{
  "name": "briefmaker",
  "version": "0.5.0",
  "description": "Generate AI agent briefs from the current note using path-based templates and task extraction.",
  "author": "Eugeny Dementev",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "npm run lint && node esbuild.config.mjs --production",
    "lint": "eslint .",
    "typecheck": "tsc -noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.52.0",
    "@types/node": "^20.11.30",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "esbuild": "^0.20.2",
    "obsidian": "^1.5.12",
    "typescript": "^5.4.3"
  }
}
